{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          { "type": "command", "command": "C:/Users/Santi/.local/bin/graphify.exe hook-guard search", "timeout": 10 }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          { "type": "command", "command": "C:/Users/Santi/.local/bin/graphify.exe hook-guard read", "timeout": 10 }
        ]
      }
    ]
  }
}